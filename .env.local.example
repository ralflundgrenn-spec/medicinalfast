# Copie este ficheiro para .env.local e preencha.
# No Vercel, adicione as mesmas variáveis em Settings -> Environment Variables.

# --- Pagamentos BlackCat (PIX) ---
# Chave da API (painel BlackCat). SEM esta chave o site corre em MODO DEMONSTRAÇÃO
# (gera um QR falso e "confirma" o pagamento em ~8s, só para testar o fluxo).
BLACKCAT_API_KEY=

# WhatsApp do médico que é liberado ao cliente APÓS o pagamento.
# Só dígitos, com código do país. Ex.: 55 + DDD + número.
DOCTOR_WHATSAPP=5511999999999

# URL pública do site (usada para o webhook da BlackCat).
# Em produção: https://seu-dominio.vercel.app
NEXT_PUBLIC_SITE_URL=

# --- Supabase (opcional, para gravar registos no futuro) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
