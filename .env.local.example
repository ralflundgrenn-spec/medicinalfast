# Supabase — copie este ficheiro para .env.local e preencha com as suas chaves
# (Project Settings -> API no painel do Supabase)

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-anon-publica

# Usada apenas no servidor (route handler /api/agendar). NUNCA expor no cliente.
SUPABASE_SERVICE_ROLE_KEY=chave-service-role-secreta
